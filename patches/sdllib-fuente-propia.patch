+bool sdl::text::SystemFont::add_font_file(const char *path)
+{
+    SystemFont &instance = SystemFont::get_instance();
+    FILE *file           = std::fopen(path, "rb");
+    if (!file) { return false; }
+    std::fseek(file, 0, SEEK_END);
+    const long size = std::ftell(file);
+    std::fseek(file, 0, SEEK_SET);
+    if (size <= 0)
+    {
+        std::fclose(file);
+        return false;
+    }
+    instance.m_customData.resize(static_cast<size_t>(size));
+    const bool read = std::fread(instance.m_customData.data(), 1, instance.m_customData.size(), file) == instance.m_customData.size();
+    std::fclose(file);
+    if (!read) { return false; }
+
+    const bool faceError = sdl::error::freetype(
+        FT_New_Memory_Face(instance.m_ftLib, instance.m_customData.data(), static_cast<FT_Long>(instance.m_customData.size()), 0, &instance.m_custom));
+    if (faceError)
+    {
+        instance.m_custom = nullptr;
+        return false;
+    }
+    FT_Set_Pixel_Sizes(instance.m_custom, 0, instance.m_fontSize);
+    instance.m_glyphCache.clear();
+    return true;
+}
